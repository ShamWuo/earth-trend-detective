# Earth Trend Detective (.env.example)

# NASA Earthdata / FIRMS (optional — POWER & EONET work out-of-the-box without keys)
NASA_FIRMS_MAP_KEY=

# DeepSeek AI Detective Key (primary LLM for web app AI + graph editing; falls back to deterministic reasoner if unset)
DEEPSEEK_API_KEY=

# Optional Gemini Synthesis Key & Model (used when DEEPSEEK_API_KEY is unset or as fallback)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen

# Optional Bearer API Key for MCP & Webhook write protection (unset = open communal mode)
ETG_API_KEY=

# Optional Supabase Cloud Persistence (falls back to local .etg-cache/etg-state.json if unset)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
